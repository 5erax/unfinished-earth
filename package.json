{
  "name": "the-unfinished-earth",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:client": "pnpm --filter @unfinished-earth/client dev",
    "dev:server": "pnpm --filter @unfinished-earth/world-server dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @unfinished-earth/db db:generate"
  }
}
